    {"id":"mapa_termos_text_2026","type":"text","x":1025,"y":1390,"width":790,"height":390,"angle":0,"strokeColor":"#201c25","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ai","roundness":null,"seed":26019,"version":1,"versionNonce":26019,"isDeleted":false,"boundElements":null,"updated":1794000000000,"link":null,"locked":false,"text":"TERMOS DE USO | termos.html\nSecoes: uso responsavel, conteudo, links externos, atualizacoes e duvidas.\nLink para contato.html na secao de duvidas.\nNavegacao reduzida: Inicio, Sobre e Contato. Tema + javascriptch.js.\nRodape © 2026.","fontSize":19,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"TERMOS DE USO | termos.html\nSecoes: uso responsavel, conteudo, links externos, atualizacoes e duvidas.\nLink para contato.html na secao de duvidas.\nNavegacao reduzida: Inicio, Sobre e Contato. Tema + javascriptch.js.\nRodape © 2026.","autoResize":true,"lineHeight":1.25},

    {"id":"mapa_privacidade_box_2026","type":"rectangle","x":1900,"y":1370,"width":840,"height":430,"angle":0,"strokeColor":"#53616b","backgroundColor":"#e8eff0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aj","roundness":{"type":3},"seed":26020,"version":1,"versionNonce":26020,"isDeleted":false,"boundElements":null,"updated":1794000000000,"link":null,"locked":false},
    {"id":"mapa_privacidade_text_2026","type":"text","x":1925,"y":1390,"width":790,"height":390,"angle":0,"strokeColor":"#201c25","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ak","roundness":null,"seed":26021,"version":1,"versionNonce":26021,"isDeleted":false,"boundElements":null,"updated":1794000000000,"link":null,"locked":false,"text":"POLITICA DE PRIVACIDADE | privacidade.html\nSecoes atuais falam de dados coletados, uso, compartilhamento, seguranca e alteracoes.\nObservacao: o texto afirma coleta em cadastro/contato, mas o formulario de Seguir nao implementa cadastro nem armazenamento.\nNavegacao reduzida: Inicio, Sobre e Contato. Sem canvas de particulas.\nRodape atual ainda mostra © 2024; revisar para alinhar ao restante do site.","fontSize":19,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"POLITICA DE PRIVACIDADE | privacidade.html\nSecoes atuais falam de dados coletados, uso, compartilhamento, seguranca e alteracoes.\nObservacao: o texto afirma coleta em cadastro/contato, mas o formulario de Seguir nao implementa cadastro nem armazenamento.\nNavegacao reduzida: Inicio, Sobre e Contato. Sem canvas de particulas.\nRodape atual ainda mostra © 2024; revisar para alinhar ao restante do site.","autoResize":true,"lineHeight":1.25},

    {"id":"mapa_js_box_2026","type":"rectangle","x":100,"y":1840,"width":2660,"height":245,"angle":0,"strokeColor":"#53616b","backgroundColor":"#edf0e7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"al","roundness":{"type":3},"seed":26022,"version":1,"versionNonce":26022,"isDeleted":false,"boundElements":null,"updated":1794000000000,"link":null,"locked":false},
    {"id":"mapa_js_text_2026","type":"text","x":130,"y":1860,"width":2600,"height":205,"angle":0,"strokeColor":"#201c25","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"am","roundness":null,"seed":26023,"version":1,"versionNonce":26023,"isDeleted":false,"boundElements":null,"updated":1794000000000,"link":null,"locked":false,"text":"COMPORTAMENTOS EM javascriptch.js\nCompartilhado: menu mobile (quando existe), tema salvo, revelacao de secoes e respeito a prefers-reduced-motion; particulas no canvas quando presente.\nSomente Inicio: banner anterior/proximo, roleta aleatoria sem repetir a frase anterior, adicionar tarefas e controles do audio.\nSomente Projetos: busca em tempo real nos cartoes e mensagem de quantidade encontrada.\nAnime.js anima titulo/foto da Inicio quando a biblioteca carrega; nao substitui os controles acima.","fontSize":19,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"COMPORTAMENTOS EM javascriptch.js\nCompartilhado: menu mobile (quando existe), tema salvo, revelacao de secoes e respeito a prefers-reduced-motion; particulas no canvas quando presente.\nSomente Inicio: banner anterior/proximo, roleta aleatoria sem repetir a frase anterior, adicionar tarefas e controles do audio.\nSomente Projetos: busca em tempo real nos cartoes e mensagem de quantidade encontrada.\nAnime.js anima titulo/foto da Inicio quando a biblioteca carrega; nao substitui os controles acima.","autoResize":true,"lineHeight":1.25}
